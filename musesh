def print_help():
    print(f"\n  {accent_bold('musesh')}  {dim('-')}  your Apple Music library, as files you own\n")
    width = max(len(cmd) for _, rows in HELP_SECTIONS for cmd, _ in rows)
    for title, rows in HELP_SECTIONS:
        print(f"  {bold(title.upper())}")
        for cmd, desc in rows:
            name, _, args = cmd.partition(" ")
            if name == "musesh" and args:
                sub, _, rest = args.partition(" ")
                shown = f"{accent('musesh')} {cyan(sub)}{(' ' + dim(rest)) if rest else ''}"
            else:
                shown = accent(cmd)
            print(f"    {shown}{' ' * (width - len(cmd))}   {desc}")
        print()
    print(f"  {bold('FILES')}  {dim(tilde(ROOT))}")
    summary([("Library/", "your collection"),
             ("Incoming/", "new downloads, waiting for 'musesh mp3'"),
             ("albums.txt", "your album list"),
             ("unmatched.csv", "tracks not found on Apple Music"),
             ("settings", tilde(SETTINGS))], indent=4)
    print(f"\n  {dim('Every command is safe to stop with Ctrl-C and run again; finished work is skipped.')}\n")


# ---------------------------------------------------------------------------
# Prompts and helpers
# ---------------------------------------------------------------------------

def human(n):
    return f"{n / GB:.1f} GB"


def plural(n, word):
    return f"{n} {word}{'' if n == 1 else 's'}"


def free_space(path):
    p = Path(path)
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free


def count_audio(folder):
    folder = Path(folder)
    if not folder.exists():
        return 0, 0
    files = [p for p in folder.rglob("*") if p.suffix.lower() in (".m4a", ".mp3") and not TRACKING & set(p.parts)]
    return len(files), sum(p.stat().st_size for p in files)


def clean_path(text):
    """Accept typed or drag-and-dropped paths (quotes, escaped spaces, ~)."""
    text = text.strip().strip("'\"").replace("\\ ", " ")
    return Path(text).expanduser()


def ask(prompt=""):
    return tty_input(f"{accent('›')} {prompt}")


def pick(title, options, allow_custom=True, custom_prompt="Path"):
    """options: list of (label, value). Enter picks the first one."""
    heading(title)
    for i, (label, _) in enumerate(options, 1):
        print(f"  {accent(str(i).rjust(2))}  {label}{dim('  (default)') if i == 1 else ''}")
    if allow_custom:
        print(f"  {accent(' c')}  {dim('another path - you can drag a file or folder in')}")
    while True:
        choice = ask().strip().lower()
        if not choice and options:
            return options[0][1]
        if choice.isdigit() and 1 <= int(choice) <= len(options):
            return options[int(choice) - 1][1]
        if allow_custom and choice == "c":
            return clean_path(ask(f"{custom_prompt}: "))
        if allow_custom and choice and ("/" in choice or choice.startswith("~")):
            return clean_path(choice)
        note("pick a number" + (", 'c', or paste a path" if allow_custom else ""))


def confirm(question, default=True):
    ans = tty_input(f"{accent('?')} {question} {dim('[Y/n]' if default else '[y/N]')} ").strip().lower()
    return default if not ans else ans.startswith("y")


def external_volumes():
    vols = []
    for v in sorted(Path("/Volumes").iterdir()):
        try:
            if v.resolve() == Path("/") or not os.access(v, os.W_OK):
                continue
            vols.append(v)
        except OSError:
            continue
    return vols


def newest_first(paths):
    return sorted(set(paths), key=lambda p: p.stat().st_mtime, reverse=True)


def downloaded_count(out):
    done = next((Path(out) / d / "done.txt" for d in (STATE, ".library-dl") if (Path(out) / d / "done.txt").exists()),
                Path(out) / STATE / "done.txt")
    return len(done.read_text().split()) if done.exists() else 0


def download_running():
    return subprocess.run(["pgrep", "-f", "library_dl.py|albums.py|soundcloud.py|apple_music.py"], capture_output=True).returncode == 0


def load_last():
    for path in (SETTINGS, OLD_SETTINGS):
        if path.exists():
            return json.loads(path.read_text())
    return {}


def save_last_run(settings):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(settings, indent=1))
    OLD_SETTINGS.unlink(missing_ok=True)  # replaced by settings.json


def collection():
    """Where the collection is: the Library folder once it has music, else the download folder."""
    if count_audio(LIBRARY)[0]:
        return LIBRARY
    last = load_last()
    if last.get("mp3_dir") and count_audio(Path(last["mp3_dir"]))[0]:
        return Path(last["mp3_dir"])
    return Path(last.get("output", DEFAULT_OUT))


def library_exports():
    return newest_first(
        p for d in ("Documents", "Desktop", "Downloads", "Music")
        for p in (HOME / d).glob("*.xml") if "library" in p.name.lower()
    )


def export_label(p, with_time=False):
    fmt = "%b %d %H:%M" if with_time else "%b %d"
    return f"{p.name}  {dim(f'{p.parent.name}, exported {time.strftime(fmt, time.localtime(p.stat().st_mtime))}')}"


