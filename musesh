#!/usr/bin/env python3
"""musesh - download and keep up with your Apple Music library. Run 'musesh help' for commands."""

import json
import os
import plistlib
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
TOOL = Path(__file__).resolve().parent / "library-dl"
DEFAULT_OUT = HOME / "Music" / "Library Download"
LAST_RUN = HOME / ".config" / "musesh" / "last-run.json"
DEFAULT_ALBUM_LIST = HOME / "Documents" / "musesh-albums.txt"
ALBUMS_SCRIPT = Path(__file__).resolve().parent / "albums.py"
VENV_PYTHON = HOME / ".local" / "pipx" / "venvs" / "gamdl" / "bin" / "python"  # has gamdl + httpx
GB = 1024 ** 3
AUDIO_EXTS = (".m4a", ".mp3", ".flac", ".alac", ".aac", ".wav", ".aiff", ".ogg", ".opus")


sys.path.insert(0, str(Path(__file__).resolve().parent))
from ui import accent, accent_bold, bold, cyan, die, dim, green, heading, note, ok, red, summary, tilde, warn  # noqa: E402

FORMATS_SCRIPT = Path(__file__).resolve().parent / "formats.py"
MP3_SCRIPT = Path(__file__).resolve().parent / "mp3.py"


HELP_SECTIONS = [
    ("Download", [
        ("musesh", "download your library from a Library.xml export (asks everything)"),
        ("musesh continue [N|all]", "next batch with the same choices as last time; N changes the batch size"),
        ("musesh albums [list]", "download whole albums from a list (default ~/Documents/musesh-albums.txt)"),
        ("musesh align", "find songs added to Apple Music since the last download and fetch them"),
    ]),
    ("Keep an eye on it", [
        ("musesh watch", "follow a download running in the background, live"),
        ("musesh status", "songs downloaded, what's running, what's unmatched"),
        ("musesh formats [all|diff]", "file types and quality: a summary, every file, or only the odd ones out"),
    ]),
    ("Tidy up and take it with you", [
        ("musesh clean", "remove folders (and leftover lyrics) emptied by deleting music"),
        ("musesh mp3 [folder]", "convert the library to 320 kbps MP3 - a USB drive by default, or any folder"),
        ("musesh prune [folder]", "after 'mp3': verify every file converted, then delete the non-MP3 originals"),
    ]),
]


def print_help():
    print(f"\n  {accent_bold('musesh')}  {dim('-')}  your Apple Music library, as files you own\n")
    width = max(len(cmd) for _, rows in HELP_SECTIONS for cmd, _ in rows)
    for title, rows in HELP_SECTIONS:
        print(f"  {bold(title.upper())}")
        for cmd, desc in rows:
            name, _, args = cmd.partition(" ")
            if name == "musesh" and args:
                sub, _, rest = args.partition(" ")
                shown = f"{accent('musesh')} {cyan(sub)}{(' ' + dim(rest)) if rest else ''}"
            else:
                shown = accent(cmd)
            print(f"    {shown}{' ' * (width - len(cmd))}   {desc}")
        print()
    last = json.loads(LAST_RUN.read_text()) if LAST_RUN.exists() else {}
    print(f"  {bold('FILES')}")
    summary([("library", tilde(last.get("output", DEFAULT_OUT))),
             ("album list", tilde(DEFAULT_ALBUM_LIST)),
             ("settings", tilde(LAST_RUN))], indent=4)
    print(f"\n  {dim('Every command is safe to stop with Ctrl-C and run again; finished work is skipped.')}\n")


# ---------------------------------------------------------------------------
# Prompts and helpers
# ---------------------------------------------------------------------------

def human(n):
    return f"{n / GB:.1f} GB"


def plural(n, word):
    return f"{n} {word}{'' if n == 1 else 's'}"


def free_space(path):
    p = Path(path)
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free


def count_audio(folder):
    folder = Path(folder)
    if not folder.exists():
        return 0, 0
    files = [p for p in folder.rglob("*") if p.suffix.lower() in (".m4a", ".mp3") and ".library-dl" not in p.parts]
    return len(files), sum(p.stat().st_size for p in files)


def clean_path(text):
    """Accept typed or drag-and-dropped paths (quotes, escaped spaces, ~)."""
    text = text.strip().strip("'\"").replace("\\ ", " ")
    return Path(text).expanduser()


def ask(prompt=""):
    return input(f"{accent('›')} {prompt}")


def pick(title, options, allow_custom=True, custom_prompt="Path"):
    """options: list of (label, value). Enter picks the first one."""
    heading(title)
    for i, (label, _) in enumerate(options, 1):
        print(f"  {accent(str(i).rjust(2))}  {label}{dim('  (default)') if i == 1 else ''}")
    if allow_custom:
        print(f"  {accent(' c')}  {dim('another path - you can drag a file or folder in')}")
    while True:
        choice = ask().strip().lower()
        if not choice and options:
            return options[0][1]
        if choice.isdigit() and 1 <= int(choice) <= len(options):
            return options[int(choice) - 1][1]
        if allow_custom and choice == "c":
            return clean_path(ask(f"{custom_prompt}: "))
        if allow_custom and choice and ("/" in choice or choice.startswith("~")):
            return clean_path(choice)
        note("pick a number" + (", 'c', or paste a path" if allow_custom else ""))


def confirm(question, default=True):
    ans = input(f"{accent('?')} {question} {dim('[Y/n]' if default else '[y/N]')} ").strip().lower()
    return default if not ans else ans.startswith("y")


def external_volumes():
    vols = []
    for v in sorted(Path("/Volumes").iterdir()):
        try:
            if v.resolve() == Path("/") or not os.access(v, os.W_OK):
                continue
            vols.append(v)
        except OSError:
            continue
    return vols


def newest_first(paths):
    return sorted(set(paths), key=lambda p: p.stat().st_mtime, reverse=True)


def downloaded_count(out):
    done = Path(out) / ".library-dl" / "done.txt"
    return len(done.read_text().split()) if done.exists() else 0


def download_running():
    return subprocess.run(["pgrep", "-f", "library_dl.py|albums.py"], capture_output=True).returncode == 0


def load_last():
    return json.loads(LAST_RUN.read_text()) if LAST_RUN.exists() else {}


def save_last_run(settings):
    LAST_RUN.parent.mkdir(parents=True, exist_ok=True)
    LAST_RUN.write_text(json.dumps(settings, indent=1))


def library_exports():
    return newest_first(
        p for d in ("Documents", "Desktop", "Downloads", "Music")
        for p in (HOME / d).glob("*.xml") if "library" in p.name.lower()
    )


def export_label(p, with_time=False):
    fmt = "%b %d %H:%M" if with_time else "%b %d"
    return f"{p.name}  {dim(f'{p.parent.name}, exported {time.strftime(fmt, time.localtime(p.stat().st_mtime))}')}"


